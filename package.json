{
  "name": "mmm-chores-alt",
  "version": "1.1.0",
  "description": "MagicMirror² module for tracking children's daily chores",
  "main": "MMM-Chores-Alt.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build:frontend": "vite build --config vite.config.frontend.ts",
    "build:backend": "vite build --config vite.config.backend.ts",
    "build": "npm run build:frontend && npm run build:backend",
    "dev": "npm run build -- --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarnuLombard/MMM-Chores-Alt.git"
  },
  "keywords": [
    "magicmirror",
    "chores",
    "kids"
  ],
  "author": "Marnu Lombard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MarnuLombard/MMM-Chores-Alt/issues"
  },
  "homepage": "https://github.com/MarnuLombard/MMM-Chores-Alt#readme",
  "dependencies": {
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/magicmirror-module": "^2.16.6",
    "@types/node": "^24.13.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.0.0",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
